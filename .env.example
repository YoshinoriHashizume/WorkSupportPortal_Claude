# PostgreSQL（Docker Compose の例と一致）
DATABASE_URL="postgresql://coredataintegrationportal:coredataintegrationportal_local_dev@localhost:5432/coredataintegrationportal"

# Auth.js — https://authjs.dev
# 必須。未設定だと開発サーバー再起動のたびに鍵が変わり、JWTSessionError / ログイン不能になる
AUTH_SECRET="長いランダム文字列を生成して設定（32文字以上推奨）"
# Auth.js v5: 多くの場合 AUTH_URL は不要（ホストはリクエストから推測）。LAN やリバースプロキシでは true
AUTH_TRUST_HOST="true"
# コールバック URL を固定したいときだけ（末尾スラッシュなし）
# AUTH_URL="http://localhost:3000"
# Next.js 15 開発: LAN IP で開くときは next.config.ts の allowedDevOrigins にホスト名を追加

# Microsoft Entra ID（未設定なら Microsoft ログインボタンは非表示）
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<テナントID>/v2.0"

# 開発のみ: dev@local / dev で Credentials ログイン
AUTH_DEV_MODE="true"

# Oracle（読み取り専用・仕様書 §8.2.1）
ORACLE_HOST="192.168.3.204"
ORACLE_PORT="1521"
ORACLE_SID="EXPJ"
ORACLE_USER="EXPJ"
ORACLE_PASSWORD=""
# true のとき Instant Client を使わず Thin のみ（接続ユーザーは DB 上でパスワード再設定済みで 11G/12C 検証子のみであること。10G 検証子のみでは NJS-116）
# ORACLE_USE_THIN="true"
# true のとき 32-bit Instant Client を ORACLE_CLIENT_LIB_DIR（または _32）からのみ読み込む。Node も必ず 32-bit（node -p process.arch が ia32）。
# ORACLE_USE_32BIT_CLIENT="true"
# ORACLE_CLIENT_LIB_DIR_32="/opt/oracle/instantclient_11_2"  # 任意。未設定なら ORACLE_CLIENT_LIB_DIR と同じ扱い
# Thick モード用: Instant Client 展開先（libclntsh.so / oci.dll があるディレクトリ）。未設定時は OS の探索パスに依存。NJS-116 回避に必須。
# Instant Client のビット数は「node -p process.arch」と一致させる（x64 の Node なら 64-bit 用パッケージ。32-bit 専用クライアントでは DPI-1047 のまま）。
# 例 Windows: ORACLE_CLIENT_LIB_DIR="C:\\oracle\\instantclient_23_7"
# 例 Linux:   ORACLE_CLIENT_LIB_DIR="/opt/oracle/instantclient_21_15"
ORACLE_CLIENT_LIB_DIR=""

# MARI（5年9組）: 複数会社が同一スキーマにあるときのみ。`M_CUST` / `M_CUST_ITEM` の COMPANY_CD に一致させる
# GONENKUKUMI_COMPANY_CD=""
