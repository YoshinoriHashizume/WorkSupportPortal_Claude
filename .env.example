# ===========================================
# プロジェクト設定（コンテナ名等に使用）
# ===========================================
PROJECT_NAME=worksupportportal

# ===========================================
# PostgreSQL設定
# ===========================================
POSTGRES_DB=worksupportportal
POSTGRES_USER=wsp
POSTGRES_PASSWORD=wsp_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# Django設定
# ===========================================
SECRET_KEY=django-insecure-local-development-key
DJANGO_SECRET_KEY=django-insecure-local-development-key
DEBUG=True
DJANGO_DEBUG=true
ALLOWED_HOSTS=*
DJANGO_ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:8990,http://127.0.0.1:8990
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8990,http://127.0.0.1:8990
PYTHONPATH=/django_app/src
DJANGO_SETTINGS_MODULE=config.settings.development
AUTH_DEV_MODE=true
AUTH_URL=http://localhost:8990
AUTH_PROVIDER=desknet
DESKNETS_LOGIN_URL=https://maruei01.dn-cloud.com/cgi-bin/dneo/dneo.cgi
DESKNETS_TIMEOUT_SECONDS=10
# 資産棚卸結果の AppSuite API 用（棚卸アプリ参照権限を持つ desknet's アカウント）
# DESKNETS_ASSET_INVENTORY_LOGIN_ID=
# DESKNETS_ASSET_INVENTORY_PASSWORD=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ===========================================
# タイムゾーン
# ===========================================
TZ=Asia/Tokyo

# ===========================================
# Git設定
# ===========================================
GIT_USER_NAME=your-name
GIT_USER_EMAIL=your-email@example.com

# ===========================================
# Oracle Database接続設定
# ===========================================
# true / 1 / yes / on のみモック。それ以外（typo・空白含む）は実接続を試みる
ORACLE_USE_MOCK=false
# 実接続時は担当者から受け取った値を設定（テンプレに本番相当の既知値は置かない）
ORACLE_HOST=
ORACLE_PORT=1521
ORACLE_SID=
ORACLE_USER=
ORACLE_PASSWORD=
# Docker 開発は Instant Client 同梱のため thick 推奨（DPY-3015 回避）
ORACLE_THICK_MODE=true
ORACLE_CLIENT_LIB_DIR=/opt/oracle/instantclient
ORACLE_CONNECT_TIMEOUT_SECONDS=5
INVENTORY_ORDER_ALERT_BANNER_TIMEOUT_SECONDS=10
