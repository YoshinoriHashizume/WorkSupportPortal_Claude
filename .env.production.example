# ===========================================
# プロジェクト設定
# Copy to .env.production on the production server. Do not commit .env.production.
# ===========================================
PROJECT_NAME=worksupportportal

# ===========================================
# Django設定
# ===========================================
# SECRET_KEYは以下のコマンドで生成してください:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=<生成したSECRET_KEYを設定>
DJANGO_SECRET_KEY=<生成したSECRET_KEYを設定>
DEBUG=False
DJANGO_DEBUG=false
ALLOWED_HOSTS=192.168.3.196
DJANGO_ALLOWED_HOSTS=192.168.3.196
CSRF_TRUSTED_ORIGINS=http://192.168.3.196
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.3.196
AUTH_DEV_MODE=false
AUTH_URL=http://192.168.3.196
AUTH_PROVIDER=desknet
DESKNETS_LOGIN_URL=https://maruei01.dn-cloud.com/cgi-bin/dneo/dneo.cgi
DESKNETS_TIMEOUT_SECONDS=10
# 資産棚卸結果 API 用（棚卸データ管理等の参照権限を持つ desknet's アカウント）
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

# ===========================================
# PostgreSQL設定
# ===========================================
POSTGRES_DB=worksupportportal
POSTGRES_USER=wsp
POSTGRES_PASSWORD=<強力なパスワードを設定>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===========================================
# タイムゾーン
# ===========================================
TZ=Asia/Tokyo

# ===========================================
# Python設定
# ===========================================
PYTHONPATH=/django_app/src
DJANGO_SETTINGS_MODULE=config.settings.production

# ===========================================
# Oracle Database接続設定
# ===========================================
ORACLE_USE_MOCK=false
ORACLE_HOST=192.168.3.204
ORACLE_PORT=1521
ORACLE_SID=EXPJ
ORACLE_USER=EXPJ
ORACLE_PASSWORD=
ORACLE_CONNECT_TIMEOUT_SECONDS=5
# Windows 直実行で DPY-3015 が出る場合は Instant Client を入れ、次を有効化
# ORACLE_THICK_MODE=true
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_23_0
INVENTORY_ORDER_ALERT_BANNER_TIMEOUT_SECONDS=10
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=120
