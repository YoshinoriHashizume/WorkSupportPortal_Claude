# Copy to .env.production on the production server. Do not commit .env.production.
#
# --- Docker 本番（§10）---
# APP_PUBLISH_PORT=80、AUTH_URL / CSRF にポート番号なし（例: http://192.168.3.196）
# DATABASE_URL は docker-compose が POSTGRES_* から組み立てるため、通常は下記行をコメントのままにする。
#
# --- Windows 直実行（§10.3）---
# APP_PUBLISH_PORT=3000、AUTH_URL / CSRF に :3000 を付ける（例: http://192.168.3.196:3000）
# DATABASE_URL を localhost の PostgreSQL に向ける（POSTGRES_PASSWORD と同じパスワードに揃える）
# 同じキーを2回書かないこと（例: APP_PUBLISH_PORT=80 と =3000 を両方有効にしない）

POSTGRES_DB=worksupportportal
POSTGRES_USER=worksupportportal
POSTGRES_PASSWORD=change-me-strong-password

# §10 Docker 用（§10.3 では APP_PUBLISH_PORT=3000 に差し替え、DATABASE_URL のコメントを外す）
APP_PUBLISH_PORT=80
# DATABASE_URL=postgresql://worksupportportal:change-me-strong-password@localhost:5432/worksupportportal

# §10.3 Windows 直実行用（上の APP_PUBLISH_PORT=80 を 3000 に変更し、DATABASE_URL のコメントを外す）
# APP_PUBLISH_PORT=3000
# DATABASE_URL=postgresql://worksupportportal:change-me-strong-password@localhost:5432/worksupportportal
# DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.3.196:3000
# AUTH_URL=http://192.168.3.196:3000

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-long-random-secret
DJANGO_ALLOWED_HOSTS=192.168.3.196
# §10 Docker 用（§10.3 では :3000 付きの行に差し替える）
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.3.196
AUTH_URL=http://192.168.3.196
AUTH_PROVIDER=desknet
DESKNETS_LOGIN_URL=https://maruei01.dn-cloud.com/cgi-bin/dneo/dneo.cgi
DESKNETS_TIMEOUT_SECONDS=10
AUTH_DEV_MODE=false

AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=

ORACLE_USE_MOCK=false
ORACLE_HOST=192.168.3.204
ORACLE_PORT=1521
ORACLE_SID=EXPJ
ORACLE_USER=EXPJ
ORACLE_PASSWORD=
ORACLE_CONNECT_TIMEOUT_SECONDS=5
# §10.3 Windows 直実行: DPY-3015 が出る場合は Instant Client を入れ、次の2行のコメントを外す（23.0 例）
# ORACLE_THICK_MODE=true
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_23_0
GONENKUKUMI_COMPANY_CD=

INVENTORY_ORDER_ALERT_BANNER_TIMEOUT_SECONDS=10
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT_SECONDS=120
