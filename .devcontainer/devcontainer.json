{
  "name": "Core Data Integration Portal",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/app",
  "shutdownAction": "stopCompose",
  "overrideCommand": false,
  "forwardPorts": [3000, 8080],
  "portsAttributes": {
    "3000": { "label": "Next.js" },
    "8080": { "label": "nginx" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["Prisma.prisma", "ms-azuretools.vscode-docker"]
    }
  }
}
